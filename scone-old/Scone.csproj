<Project Sdk="Uno.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0-desktop</TargetFramework>

		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>

		<!-- Display name -->
		<ApplicationTitle>Scone</ApplicationTitle>
		<!-- App Identifier -->
		<ApplicationId>com.companyname.scone</ApplicationId>
		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<!-- Package Publisher -->
		<ApplicationPublisher>Scone</ApplicationPublisher>
		<!-- Package Description -->
		<Description>Scone powered by Uno Platform.</Description>
		<!-- Windows executable icon -->
		<ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>

		<!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you
		want to use.
      https://aka.platform.uno/singleproject-features
    -->
		<UnoFeatures>
			SkiaRenderer;
		</UnoFeatures>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BCnEncoder.Net" />
		<PackageReference Include="geometry3Sharp" />
		<PackageReference Include="Newtonsoft.Json" />
		<PackageReference Include="SharpGLTF.Toolkit" />
		<None Include="jetway-template.nas" CopyToOutputDirectory="PreserveNewest" />
		<Content Include="Tools/gltf-validator/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<GltfRepairSource Include="Tools/gltf-repair/src/**/*.ts" />
		<GltfRepairPackagingScript Include="Tools/gltf-repair/scripts/**/*.mjs" />
	</ItemGroup>

	<Target Name="BuildGltfRepairCli"
			BeforeTargets="Build">
		<Message Importance="high" Text="Building gltf-repair CLI tool..." />
		<Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)/Tools/gltf-repair" Condition="!Exists('$(MSBuildProjectDirectory)/Tools/gltf-repair/node_modules') or !Exists('$(MSBuildProjectDirectory)/Tools/gltf-repair/node_modules/pkg')" />
		<Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/Tools/gltf-repair" />
		<Exec Command="npm run build:pkg-entry" WorkingDirectory="$(MSBuildProjectDirectory)/Tools/gltf-repair" />
		<Exec Command="npm run package-binary -- --targets=$(GltfRepairPkgTargets)" WorkingDirectory="$(MSBuildProjectDirectory)/Tools/gltf-repair" Condition="'$(GltfRepairPkgTargets)' != ''" />
		<Exec Command="npm run package-binary" WorkingDirectory="$(MSBuildProjectDirectory)/Tools/gltf-repair" Condition="'$(GltfRepairPkgTargets)' == ''" />
		<Exec Command="find Tools/gltf-repair/bin -maxdepth 1 -type f ! -name '*.exe' -exec chmod +x {} +" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'$(OS)' != 'Windows_NT' and Exists('$(MSBuildProjectDirectory)/Tools/gltf-repair/bin')" />
	</Target>

	<Target Name="CopyGltfRepairCliToBuildOutput" AfterTargets="Build">
		<ItemGroup>
			<_GltfRepairBuildBinaryFiles Include="$(MSBuildProjectDirectory)/Tools/gltf-repair/bin/*" />
			<_GltfRepairBuildBinaryFiles Remove="@(_GltfRepairBuildBinaryFiles)" Condition="$([System.IO.Directory]::Exists('%(Identity)'))" />
		</ItemGroup>

		<RemoveDir Directories="$(OutDir)Tools/gltf-repair" Condition="Exists('$(OutDir)Tools/gltf-repair')" />
		<MakeDir Directories="$(OutDir)Tools/gltf-repair" />

		<Copy SourceFiles="@(_GltfRepairBuildBinaryFiles)"
			  DestinationFolder="$(OutDir)Tools/gltf-repair/"
			  SkipUnchangedFiles="true" />
		<Exec Command="find &quot;$(OutDir)Tools/gltf-repair&quot; -maxdepth 1 -type f ! -name '*.exe' -exec chmod +x {} +" Condition="'$(OS)' != 'Windows_NT' and Exists('$(OutDir)Tools/gltf-repair')" />
	</Target>

	<Target Name="CopyGltfRepairCliToPublishOutput" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
		<ItemGroup>
			<_GltfRepairPublishBinaryFiles Include="$(MSBuildProjectDirectory)/Tools/gltf-repair/bin/*" />
			<_GltfRepairPublishBinaryFiles Remove="@(_GltfRepairPublishBinaryFiles)" Condition="$([System.IO.Directory]::Exists('%(Identity)'))" />
		</ItemGroup>

		<RemoveDir Directories="$(PublishDir)Tools/gltf-repair" Condition="Exists('$(PublishDir)Tools/gltf-repair')" />
		<MakeDir Directories="$(PublishDir)Tools/gltf-repair" />

		<Copy SourceFiles="@(_GltfRepairPublishBinaryFiles)"
			  DestinationFolder="$(PublishDir)Tools/gltf-repair/"
			  SkipUnchangedFiles="true" />
		<Exec Command="find &quot;$(PublishDir)Tools/gltf-repair&quot; -maxdepth 1 -type f ! -name '*.exe' -exec chmod +x {} +" Condition="'$(OS)' != 'Windows_NT' and Exists('$(PublishDir)Tools/gltf-repair')" />
	</Target>

</Project>