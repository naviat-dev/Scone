{
  "name": "scone",
  "version": "2.0.0",
  "description": "Tooling to convert scenery for Microsoft Flight Simulator to FlightGear",
  "homepage": "https://github.com/naviat-dev/Scone#readme",
  "bugs": {
    "url": "https://github.com/naviat-dev/Scone/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naviat-dev/Scone.git"
  },
  "license": "CC-BY-NC-SA-4.0",
  "author": "Israel Emmanuel",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer && npm run build:tools",
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "esbuild renderer.ts --bundle --platform=browser --format=esm --sourcemap --outfile=dist/renderer.js",
    "build:tools": "node scripts/copy-gltf-validator.cjs",
    "build:runtime": "node scripts/copy-node-runtime.cjs",
    "start": "npm run build && node dist/start.js",
    "package": "npm run build && npm run build:runtime && electron-builder --publish never",
    "test": "npm run build:main && node --test dist/conversion-runtime.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "node": "24.16.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "build": {
    "afterPack": "./scripts/verify-packaged-runtime.cjs",
    "asarUnpack": [
      "package.json",
      "Assets/**/*",
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!.runtime{,/**/*}"
    ],
    "extraResources": [
      {
        "from": ".runtime",
        "to": "runtime"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@xmldom/xmldom": "^0.9.12",
    "gl-matrix": "^3.4.4",
    "gltf-validator": "^2.0.0-dev.3.10",
    "ktx-parse": "^2.0.0",
    "path": "^0.12.7",
    "pngjs": "^7.0.0",
    "xmlbuilder2": "^4.0.3",
    "xmldom": "^0.6.0"
  },
  "allowScripts": {
    "node@24.16.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
